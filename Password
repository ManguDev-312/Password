<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CrystalPass - Generatore di Password Sicure</title>
    <style>
        :root {
            --bg-gradient: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #2e1065 100%);
            --crystal-bg: rgba(255, 255, 255, 0.03);
            --crystal-border: rgba(255, 255, 255, 0.08);
            --crystal-highlight: rgba(255, 255, 255, 0.15);
            --interface-glow: rgba(56, 189, 248, 0.15);
            --text-primary: #f8fafc;
            --text-secondary: #94a3b8;
            --accent-color: #38bdf8;
            --accent-glow: rgba(56, 189, 248, 0.3);
            --success-color: #34d399;
            --warning-color: #fbbf24;
            --danger-color: #f87171;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif;
        }

        body {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: var(--bg-gradient);
            overflow-x: hidden;
            position: relative;
            padding: 20px;
        }

        /* Sfondi sfumati decorativi moderni */
        body::before, body::after {
            content: '';
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            z-index: 0;
        }

        body::before {
            width: 400px;
            height: 400px;
            background: rgba(99, 102, 241, 0.15);
            top: 10%;
            left: 15%;
        }

        body::after {
            width: 350px;
            height: 350px;
            background: rgba(236, 72, 153, 0.1);
            bottom: 10%;
            right: 15%;
        }

        /* Contenitore Principale */
        .password-container {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 450px;
            padding: 30px;
            background: var(--crystal-bg);
            backdrop-filter: blur(35px) saturate(200%);
            -webkit-backdrop-filter: blur(35px) saturate(200%);
            border: 1px solid var(--crystal-border);
            border-radius: 24px;
            box-shadow: 
                0 30px 60px rgba(0, 0, 0, 0.4),
                inset 0 1px 0 var(--crystal-highlight);
        }

        .brand {
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: var(--text-secondary);
            margin-bottom: 25px;
            text-align: center;
            font-weight: 700;
        }

        .brand span {
            color: var(--accent-color);
            text-shadow: 0 0 10px var(--accent-glow);
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            font-size: 0.8rem;
            color: var(--text-secondary);
            margin-bottom: 10px;
            font-weight: 600;
        }

        /* Controllo Lunghezza Range */
        .range-wrapper {
            display: flex;
            align-items: center;
            gap: 15px;
            background: rgba(0, 0, 0, 0.2);
            padding: 12px 16px;
            border-radius: 12px;
            border: 1px solid var(--crystal-border);
        }

        input[type="range"] {
            flex: 1;
            accent-color: var(--accent-color);
            cursor: pointer;
        }

        .length-badge {
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--accent-color);
            min-width: 28px;
            text-align: center;
        }

        /* Opzioni Complessità (Checkbox) */
        .options-grid {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-bottom: 20px;
            background: rgba(0, 0, 0, 0.15);
            padding: 14px;
            border-radius: 12px;
            border: 1px solid var(--crystal-border);
        }

        .option-item {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--text-primary);
            font-size: 0.9rem;
            cursor: pointer;
            user-select: none;
        }

        .option-item input {
            cursor: pointer;
            accent-color: var(--accent-color);
            width: 16px;
            height: 16px;
        }

        /* Box di Visualizzazione Risultato */
        .display-box {
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid var(--crystal-border);
            border-radius: 14px;
            padding: 16px;
            margin-top: 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            box-shadow: inset 0 2px 8px rgba(0,0,0,0.3);
            transition: all 0.3s;
        }

        .display-box.focused {
            border-color: var(--accent-color);
            box-shadow: inset 0 2px 8px rgba(0,0,0,0.3), 0 0 15px var(--interface-glow);
        }

        .output-string {
            font-size: 1.2rem;
            color: var(--text-primary);
            font-family: 'Courier New', Courier, monospace;
            font-weight: bold;
            word-break: break-all;
            user-select: all;
            flex: 1;
        }

        .btn-copy {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--crystal-border);
            color: var(--text-secondary);
            padding: 8px 14px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            transition: all 0.2s;
        }

        .btn-copy:hover {
            background: rgba(255, 255, 255, 0.1);
            color: var(--text-primary);
        }

        /* Pulsante Principale */
        .btn-generate {
            width: 100%;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(56, 189, 248, 0.4);
            color: var(--accent-color);
            padding: 14px 0;
            border-radius: 12px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            transition: all 0.2s ease;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        }

        .btn-generate:hover {
            background: rgba(56, 189, 248, 0.08);
            border-color: var(--accent-color);
            box-shadow: 0 0 20px var(--interface-glow);
            transform: translateY(-1px);
        }

        .btn-generate:active {
            transform: translateY(1px);
        }

        /* Info Sicurezza Inferiore */
        .status-panel {
            margin-top: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 5px;
            font-size: 0.8rem;
            color: var(--text-secondary);
        }

        .status-strength {
            font-weight: 600;
            transition: color 0.3s ease;
        }
    </style>
</head>
<body>

    <div class="password-container">
        <div class="brand">Crystal<span>Pass</span></div>
        
        <div class="form-group">
            <label for="char-range">Lunghezza della password</label>
            <div class="range-wrapper">
                <input type="range" id="char-range" min="6" max="32" value="16" oninput="updateRangeLabel()">
                <div class="length-badge" id="range-val">16</div>
            </div>
        </div>

        <div class="options-grid">
            <label class="option-item">
                <input type="checkbox" id="opt-uppercase" checked onchange="evaluateStrengthOnly()">
                Includi lettere maiuscole (A-Z)
            </label>
            <label class="option-item">
                <input type="checkbox" id="opt-numbers" checked onchange="evaluateStrengthOnly()">
                Includi numeri (0-9)
            </label>
            <label class="option-item">
                <input type="checkbox" id="opt-symbols" checked onchange="evaluateStrengthOnly()">
                Includi simboli speciali (@#$!%*?)
            </label>
        </div>

        <button class="btn-generate" onclick="generateSecurePassword()">Genera Password</button>

        <div class="display-box" id="display-container">
            <div class="output-string" id="password-output">••••••••••••••••</div>
            <button class="btn-copy" id="copy-button" onclick="copyToClipboard()">Copia</button>
        </div>

        <div class="status-panel">
            <div>Sicurezza garantita localmente</div>
            <div class="status-strength" id="password-strength">Sicurezza: --</div>
        </div>
    </div>

    <script>
        const rangeSlider = document.getElementById('char-range');
        const rangeLabel = document.getElementById('range-val');
        const outputField = document.getElementById('password-output');
        const displayContainer = document.getElementById('display-container');
        const strengthLabel = document.getElementById('password-strength');

        function updateRangeLabel() {
            rangeLabel.innerText = rangeSlider.value;
            evaluateStrengthOnly();
        }

        function evaluateStrengthOnly() {
            const length = parseInt(rangeSlider.value);
            let activeTypes = 1; // Lettere minuscole di base sempre incluse
            if (document.getElementById('opt-uppercase').checked) activeTypes++;
            if (document.getElementById('opt-numbers').checked) activeTypes++;
            if (document.getElementById('opt-symbols').checked) activeTypes++;

            if (length < 10 || activeTypes <= 2) {
                strengthLabel.innerText = "Sicurezza: Debole";
                strengthLabel.style.color = "var(--danger-color)";
            } else if (length < 14 || activeTypes === 3) {
                strengthLabel.innerText = "Sicurezza: Media";
                strengthLabel.style.color = "var(--warning-color)";
            } else {
                strengthLabel.innerText = "Sicurezza: Forte";
                strengthLabel.style.color = "var(--success-color)";
            }
        }

        function generateSecurePassword() {
            const length = parseInt(rangeSlider.value);
            
            // Costruzione del set di caratteri dinamico in base alle scelte dell'utente
            let allowedChars = "abcdefghijklmnopqrstuvwxyz";
            if (document.getElementById('opt-uppercase').checked) allowedChars += "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
            if (document.getElementById('opt-numbers').checked) allowedChars += "0123456789";
            if (document.getElementById('opt-symbols').checked) allowedChars += "@#$!%*?&-_=+[]{}";

            // Controllo nel caso in cui l'utente tolga tutte le spunte
            if (allowedChars === "") {
                outputField.innerText = "Seleziona un'opzione";
                strengthLabel.innerText = "Sicurezza: --";
                strengthLabel.style.color = "";
                return;
            }

            // Generazione sicura tramite Web Cryptography API
            const randomValues = new Uint32Array(length);
            window.crypto.getRandomValues(randomValues);
            
            let password = "";
            for (let i = 0; i < length; i++) {
                password += allowedChars[randomValues[i] % allowedChars.length];
            }

            // Aggiornamento interfaccia ed effetto grafico di conferma
            outputField.innerText = password;
            evaluateStrengthOnly();

            displayContainer.classList.add('focused');
            setTimeout(() => displayContainer.classList.remove('focused'), 400);
        }

        function copyToClipboard() {
            const textToCopy = outputField.innerText;
            if (textToCopy === "••••••••••••••••" || textToCopy === "Seleziona un'opzione") return;

            navigator.clipboard.writeText(textToCopy).then(() => {
                const copyBtn = document.getElementById('copy-button');
                copyBtn.innerText = "Copiato!";
                copyBtn.style.color = "var(--success-color)";
                
                setTimeout(() => {
                    copyBtn.innerText = "Copia";
                    copyBtn.style.color = "";
                }, 1500);
            });
        }

        // Inizializzazione della barra di stato all'avvio
        evaluateStrengthOnly();
    </script>
</body>
</html>
